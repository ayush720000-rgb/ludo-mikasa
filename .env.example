# Required for verified Telegram Mini App identity and Bot API profile/photo lookup.
# Keep this secret in Render Environment settings; never commit a real token.
TELEGRAM_BOT_TOKEN=

# Optional: bot and Mini App links (defaults shown).
BOT_USERNAME=Ig_MikasaBot
MINIAPP_SHORT_NAME=ludo
# Your public domain, used for shared result links (e.g. https://play.example.com).
PUBLIC_URL=

# Render supplies PORT automatically.
NODE_ENV=production
